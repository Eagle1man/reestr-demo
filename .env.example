# Шаблон окружения. Скопируйте в .env и заполните значения.
# .env находится в .gitignore и НЕ должен попадать в репозиторий (SEC-05).

# --- Приложение ---
APP_NAME=Реестр научных проектов Южного университета (ИУБиП)
# Только для разработки. В рабочей среде запускать за обратным прокси HTTPS (SEC-01).
DEBUG=false
# Разрешённые источники для CORS, через запятую. Пусто = только свой origin.
CORS_ORIGINS=

# --- База данных (SQLite; п.3.1 ТЗ — одна реляционная БД) ---
DATABASE_PATH=backend/data/registry.db
# Интервал ожидания блокировки записи при параллельной работе (NFR-01: 50 пользователей)
SQLITE_TIMEOUT_SECONDS=30

# --- Безопасность (п.11.1 ТЗ) ---
# ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
# Минимальная длина пароля, п.11.1
PASSWORD_MIN_LENGTH=12
# Блокировка после 5 неудачных попыток на 15 минут, п.11.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Порог перебора по адресу. Выше порога учётной записи: иначе посторонний,
# отправив 5 неверных паролей от имени сотрудника, заблокирует ему вход.
LOGIN_IP_MAX_ATTEMPTS=25
# Сессия завершается после 60 минут бездействия, п.11.1
SESSION_IDLE_MINUTES=60

# --- Резервное копирование (п.11.4 ТЗ) ---
BACKUP_DIR=backups
# Ежедневные копии хранятся не менее 30 календарных дней
BACKUP_RETENTION_DAYS=30
# Контрольное восстановление выполняется при приёмке и далее раз в квартал
BACKUP_VERIFY_ON_RESTORE=true

# --- Публичная зона (FR-33, раздел 9.4 ТЗ) ---
# Ограничение частоты запросов публичного API, запросов в минуту с одного адреса
PUBLIC_RATE_LIMIT_PER_MINUTE=60
# Разрешённые домены официального сайта, через запятую (CORS публичного API)
PUBLIC_ALLOWED_ORIGINS=

# --- Загрузка материалов (FR-21, вторая очередь) ---
# Предельный размер одного файла, байт. По умолчанию 20 МБ.
UPLOAD_MAX_BYTES=20971520
# Разрешённые расширения файлов, через запятую
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.txt,.png,.jpg,.zip