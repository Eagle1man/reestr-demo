[Unit]
Description=Ежедневное резервное копирование реестра научных проектов (п.11.4 ТЗ)
Documentation=file:/opt/registry/docs/ИНСТРУКЦИЯ-РАЗВЁРТЫВАНИЯ.md

[Timer]
# Не реже одного раза в сутки. Время выбрано вне рабочего пика.
OnCalendar=*-*-* 03:17:00
# Разброс по времени, чтобы несколько серверов не копировали одновременно.
RandomizedDelaySec=600
# Если сервер был выключен — копия выполняется при включении.
Persistent=true

[Install]
WantedBy=timers.target